# Copiar a .env.production en el servidor y completar valores reales.
# Nunca commitear el archivo .env.production real.

DB_USERNAME=case_tool_admin
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_NAME=case_tool

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AI_PROVIDER=gemini (por defecto) usa Google Gemini en la nube.
# AI_PROVIDER=ollama usa un Ollama local corriendo en la MISMA maquina
# (Plan B sin internet, ver docs/Plan-B-Local.md).
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:1.5b-instruct
OLLAMA_VISION_MODEL=moondream

JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA

AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
