{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--host"
      ],
      "port": 5173
    },
    {
      "name": "flutter-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "flutter-template/build/web"
      ],
      "port": 8090
    }
  ]
}