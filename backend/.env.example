PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=case_tool

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AI_PROVIDER=gemini (por defecto) usa Google Gemini en la nube.
# AI_PROVIDER=ollama usa un Ollama local (Plan B sin internet, ver
# docs/Plan-B-Local.md) — no requiere GEMINI_API_KEY en ese caso.
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:1.5b-instruct
OLLAMA_VISION_MODEL=moondream

JWT_SECRET=change-me-to-a-long-random-string

AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
