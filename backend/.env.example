PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=case_tool

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AI_PROVIDER=hybrid (por defecto): dos motores con respaldo automatico.
#   AI_HYBRID_ORDER=cloud-first (defecto): Gemini primero; Ollama responde
#     cuando no hay internet (espera hasta OLLAMA_FALLBACK_TIMEOUT_MS).
#   AI_HYBRID_ORDER=local-first: Ollama primero (demo); Gemini si Ollama no
#     responde en OLLAMA_TIMEOUT_MS (medido en CPU: 8-13 s por respuesta).
# AI_PROVIDER=gemini: solo Google Gemini en la nube.
# AI_PROVIDER=ollama: solo Ollama local (Plan B sin internet, ver
#   docs/Plan-B-Local.md) — no requiere GEMINI_API_KEY en ese caso.
AI_PROVIDER=hybrid
AI_HYBRID_ORDER=cloud-first
OLLAMA_TIMEOUT_MS=20000
OLLAMA_FALLBACK_TIMEOUT_MS=60000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:1.5b-instruct
OLLAMA_VISION_MODEL=moondream

JWT_SECRET=change-me-to-a-long-random-string

AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MongoDB (2do Parcial): diagramas, sesiones, bitacora y chat grupal
MONGO_URI=mongodb://localhost:27017/case_tool
