@startuml 05_secuencia_chat_ia
' Diagrama de secuencia — pregunta al Moderador IA en el chat grupal — UML 2.5.1 (OMG)
' Cada mensaje es una operación de la clase que lo recibe (ver el código citado).
' Refleja: frontend/src/components/ChatPanel.tsx, backend/src/ai/chat/chat.gateway.ts,
'          backend/src/ai/moderator/moderator.service.ts, backend/src/ai/ai.service.ts,
'          backend/src/ai/providers/hybrid.provider.ts
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #EAF2FB
skinparam ParticipantBorderColor #2C3E50
skinparam NoteBackgroundColor #FFF8DC
autonumber "<b>0."
title Secuencia — Pregunta pública al Moderador IA (2do Parcial)\n<size:11>UML 2.5.1 · fragmentos alt / opt / par · cada mensaje es una operación de la clase que lo recibe</size>

actor "Luis\n(navegador)" as luis
participant ":ChatPanel" as panel
participant ":ChatGateway" as gw
participant ":ModeratorService" as mod
participant ":Model<GroupChatMessage>" as chat
participant ":DiagramsService" as diag
participant ":Model<ActivityLog>" as logs
participant ":SessionsService" as sess
participant ":AiService" as ai
participant ":HybridAiProvider" as hybrid
participant ":GeminiProvider" as gemini
participant ":OllamaProvider" as ollama
participant ":Server (Socket.io)" as room

luis -> panel : sendText(text) ["¿Qué es una composición?", botón IA activo]
panel -> gw : handleSend(client, payload) [chat:send, askAi = true]
alt usuario no autenticado
  gw --> panel : chat:error "Inicia sesión…"
else autenticado
  gw -> mod : storeUserMessage(diagramId, user, text)
  mod -> chat : create({diagramId, sender, text, timestamp})
  chat --> mod : mensaje (id)
  mod --> gw : question
  gw -> room : emit('chat:new-message', question)
  gw -> room : emit('ai:status', {isThinking: true, promptBy: "Luis"})
  gw -> mod : answer(diagramId, user, question)
  par contexto dual
    mod -> diag : findOne(diagramId) [modelo + autoría]
  else
    mod -> logs : find({diagramId}) [últimas 25: contexto grupal]
  else
    mod -> chat : find({diagramId}) [chat de la sala, últimos 8]
  else
    mod -> chat : find({sender o addressedTo = Luis}) [hilo individual]
  else
    mod -> sess : getLatest(diagramId) [participantes conectados]
  end
  mod -> ai : editDiagram(text, model, prompts)
  ai -> hybrid : editDiagram(message, model, options)
  hybrid -> hybrid : textChain()
  alt AI_HYBRID_ORDER = cloud-first (defecto)
    hybrid -> gemini : editDiagram(message, model, options)
    alt Gemini responde
      gemini --> hybrid : {reply, operations}
    else sin internet / error
      gemini --> hybrid : error
      hybrid -> hybrid : onFailure(member, err, next) [circuit breaker 30 s]
      hybrid -> ollama : editDiagram(message, model, options) [prompt lite, timeout 60 s]
      ollama --> hybrid : {reply, operations}
    end
  else AI_HYBRID_ORDER = local-first (demo)
    hybrid -> ollama : editDiagram(message, model, options) [timeout 20 s]
    alt responde a tiempo
      ollama --> hybrid : {reply, operations}
    else timeout
      hybrid -> gemini : editDiagram(message, model, options)
      gemini --> hybrid : {reply, operations}
    end
  end
  hybrid --> ai : resultado + providerUsed
  ai --> mod : EditDiagramResult (operaciones validadas)
  mod -> chat : create({sender: IA, addressedTo: Luis, providerUsed})
  mod --> gw : answer, operations
  gw -> room : emit('chat:new-message', {"Luis, …", providerUsed, operations})
  gw -> room : emit('ai:status', {isThinking: false})
  room -> panel : onNewMessage(message)
  opt operations no vacías y el cliente es el de Luis
    panel -> panel : onApplyAiOperations(operations) [App aplica y guarda con source = AI]
  end
end
note right of mod
  answer() además usa funciones de módulo:
  classifyRequest() (intent.ts), buildModeratorPrompt() y
  ensureAddressed() (moderator-prompt.ts), applyCanvasPolicy()
end note
note right of ai : editDiagram() valida con validateOperations()\n(descarta clases inexistentes o duplicadas)
@enduml
