@startuml 06_secuencia_guardado_autoria
' Diagrama de secuencia — guardado con autoría granular — UML 2.5.1 (OMG)
' Cada mensaje es una operación de la clase que lo recibe (ver el código citado).
' Refleja: frontend/src/App.tsx (saveDiagram), frontend/src/api/client.ts (updateDiagram),
'          backend/src/auth/guards/jwt-auth.guard.ts, backend/src/diagrams/diagrams.controller.ts,
'          backend/src/diagrams/diagrams.service.ts, backend/src/diagrams/authorship.util.ts
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #EAF2FB
skinparam ParticipantBorderColor #2C3E50
skinparam NoteBackgroundColor #FFF8DC
autonumber "<b>0."
title Secuencia — Guardado con autoría granular (2do Parcial)\n<size:11>UML 2.5.1 · cada mensaje es una operación de la clase que lo recibe</size>

actor "Marco\n(navegador)" as marco
participant ":App\n(lienzo)" as app
participant ":ApiClient" as api
participant ":JwtAuthGuard" as guard
participant ":AuthService" as authSvc
participant ":DiagramsController" as ctl
participant ":DiagramsService" as svc
participant ":AuthorshipUtil" as auth
participant ":Model<Diagram>" as dmodel
participant ":Model<ActivityLog>" as lmodel
participant ":DiagramsGateway" as gw

note over marco : agregó el atributo "total" a Pedido; un efecto de App ya lo emitió\na la sala (diagram-update) y el visor móvil resalta la clase
marco -> app : saveDiagram(false, 'MANUAL') [botón Guardar; también autoguardado cada 30 s o tras un cambio de la IA]
app -> api : updateDiagram(id, name, model, source)
api -> guard : canActivate(context) [PATCH /diagrams/:id, Bearer JWT]
guard -> authSvc : verifyToken(token)
alt token inválido
  authSvc --> guard : error
  guard --> api : 401 Unauthorized
else válido
  authSvc --> guard : JwtPayload
  guard -> ctl : update(id, dto, user)
  note right of ctl : ValidationPipe (whitelist): los campos author/lastModifiedBy\nque envíe el cliente se descartan
  ctl -> svc : update(id, dto, user, source)
  svc -> svc : findOne(id)
  svc -> dmodel : findById(id)
  dmodel --> svc : modelo anterior
  svc -> auth : applyAuthorship(anterior, nuevo, stamp{Marco, ahora, source})
  note right of auth
    elemento nuevo     -> author = Marco
    elemento cambiado  -> conserva author, lastModifiedBy = Marco
    sin cambios        -> conserva sus sellos
    (mover la clase NO cuenta como cambio)
  end note
  auth --> svc : modelo con autoría
  svc -> auth : diffModel(anterior, nuevo)
  auth --> svc : [ATTRIBUTE_ADDED "Agregó el atributo total: Double a Pedido"]
  svc -> dmodel : findByIdAndUpdate(id, {$set: model, lastModifiedBy})
  opt hay cambios reales
    svc -> svc : logChanges(diagramId, author, changes)
    svc -> lmodel : insertMany(entradas) [+ "(vía IA)" si source = AI]
  end
  svc --> ctl : diagrama guardado
  ctl -> gw : emitAuthorship(id, model)
  note right of gw : emite diagram:authorship a la sala: ClassInspector (web)\ny el visor Flutter actualizan "Creada por…"
  ctl --> api : 200 OK (diagrama)
end
@enduml
