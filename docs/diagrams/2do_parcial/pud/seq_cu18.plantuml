@startuml seq_cu18
!include _seq.iuml
title CU18 — Reanudar Sesión de Trabajo\n<size:11>Diagrama de Secuencia · UML 2.5.1 · cada mensaje es una operación de la clase que lo recibe</size>
actor Integrante as A
boundary ":App" as B
control ":DiagramsGateway" as G
control ":SessionsService" as S
participant ":Model<DiagramSession>" as DB
boundary ":ChatPanel" as CH
A -> B : loadDiagram(id) [abre el diagrama otro día]
B -> G : handleJoin(client, payload) [join-diagram, JWT en el handshake]
G -> S : join(diagramId, user)
S -> S : getLatest(diagramId)
alt existe una sesión PAUSED
  S -> DB : findByIdAndUpdate(id, {status: ACTIVE, participante online})
else no existe sesión
  S -> DB : create({diagramId, status: ACTIVE, participants})
end
G -> S : getInitState(diagramId)
S --> G : {session, recentActivity, chat}
G -> CH : onInitState(state) [session:init-state]
CH --> A : chat e historial restaurados
note over S : al salir el último integrante, leave() deja status = PAUSED
@enduml
