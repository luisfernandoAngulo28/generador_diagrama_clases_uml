@startuml seq_cu14
!include _seq.iuml
title CU14 — Enviar Mensaje al Chat Grupal\n<size:11>Diagrama de Secuencia · UML 2.5.1 · cada mensaje es una operación de la clase que lo recibe</size>
actor Integrante as A
boundary ":ChatPanel" as B
control ":ChatGateway" as G
control ":ModeratorService" as M
participant ":Model<GroupChatMessage>" as DB
participant ":Server (Socket.io)" as SV
boundary ":ChatPanel (cada integrante)" as O
control ":LiveRoom (móvil)" as L
A -> B : sendText(text) [botón IA apagado]
B -> B : onEnsureSaved()
B -> G : handleSend(client, payload) [chat:send, askAi = false]
G -> M : storeUserMessage(diagramId, user, text)
M -> DB : create({diagramId, sender, text, timestamp})
DB --> M : documento (id)
M --> G : ChatMessage
G -> SV : emit('chat:new-message', question) [a la sala]
SV -> O : onNewMessage(message)
SV -> L : _onChatMessage(data)
note over G : resolveSocketUser() identifica al usuario por el JWT\ndel handshake. askAi = false y sin "@IA": la IA no interviene
@enduml
