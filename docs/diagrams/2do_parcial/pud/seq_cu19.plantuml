@startuml seq_cu19
!include _seq.iuml
title CU19 — Visualizar Diagrama en Vivo\n<size:11>Diagrama de Secuencia · UML 2.5.1 · cada mensaje es una operación de la clase que lo recibe</size>
actor "Integrante (móvil)" as A
boundary ":_LiveDiagramPage" as V
control ":CaseApi" as API
control ":DiagramsController" as C
control ":LiveRoom" as L
control ":DiagramsGateway" as G
participant ":Server (Socket.io)" as SV
A -> V : initState() [abre un diagrama de la lista]
V -> API : getDiagram(id)
API -> C : findOne(id) [GET /diagrams/:id, JWT]
C --> API : diagrama (modelo + autoría)
API --> V : UmlDiagramView
V -> L : connect()
L -> G : handleJoin(client, payload) [join-diagram, JWT]
G --> L : session:init-state, presence, locks-update
L --> V : notifyListeners() — dibuja clases y relaciones (solo lectura)
G -> SV : emit('diagram-update', {nodes, edges, editorName}) [cambio de otro integrante]
SV -> L : _onDiagramUpdate(data)
L -> L : _highlight(changed)
L -> L : _notifyDiagramChange(editor, names)
L --> V : resalta "Luis modificó Pedido"
@enduml
