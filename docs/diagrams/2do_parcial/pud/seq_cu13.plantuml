@startuml seq_cu13
!include _seq.iuml
title CU13 — Iniciar Sesión\n<size:11>Diagrama de Secuencia · UML 2.5.1 · cada mensaje es una operación de la clase que lo recibe</size>
actor Integrante as A
boundary ":LoginPage" as B
participant ":AuthProvider" as CTX
participant ":ApiClient" as API
control ":AuthController" as C
control ":AuthService" as S
control ":UsersService" as U
A -> B : handleSubmit(e) [correo y contraseña]
B -> CTX : login(email, password)
CTX -> API : loginUser(email, password)
API -> C : login(dto) [POST /auth/login]
C -> S : login(dto)
S -> U : findByEmail(email)
U --> S : usuario (passwordHash)
alt credenciales válidas
  S -> S : toAuthResult(user)
  S --> C : {token, user}
  C --> API : 201 {token, user}
  API --> CTX : AuthResult
  CTX -> CTX : persistSession(token, user)
  CTX --> B : sesión iniciada
  B --> A : abre la herramienta
else credenciales inválidas
  S --> C : UnauthorizedException
  C --> API : 401
  API --> CTX : error
  CTX --> B : "Correo o contraseña incorrectos."
end
note over S : login() verifica la contraseña con bcrypt.compare();\ntoAuthResult() firma el JWT {sub, email, name}
@enduml
