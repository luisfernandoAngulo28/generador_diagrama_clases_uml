@startuml seq_cu16
!include _seq.iuml
title CU16 — Solicitar Cambio del Diagrama a la IA\n<size:11>Diagrama de Secuencia · UML 2.5.1 · cada mensaje es una operación de la clase que lo recibe</size>
actor "Integrante (Luis)" as A
boundary ":ChatPanel (Luis)" as B
control ":ChatGateway" as G
control ":ModeratorService" as M
participant ":Intent" as I
participant ":CanvasPolicy" as P
participant ":Server (Socket.io)" as SV
boundary ":App (lienzo de Luis)" as L
participant ":ApiClient" as API
control ":DiagramsController" as C
control ":DiagramsService" as D
A -> B : sendText(text) ["Agrega la clase Producto…"]
B -> G : handleSend(client, payload) [chat:send, askAi = true]
G -> M : answer(diagramId, user, question)
M -> I : classifyRequest(text)
I --> M : CHANGE
M -> P : applyCanvasPolicy(operations, text, canEditCanvas)
P --> M : operaciones permitidas
M --> G : answer, operations
G -> SV : emit('chat:new-message', {answer, operations})
SV -> B : onNewMessage(message)
opt el cliente es el de quien pidió el cambio
  B -> L : applyAiOperations(operations)
  L -> L : saveDiagram(true, 'AI')
  L -> API : updateDiagram(id, name, model, 'AI')
  API -> C : update(id, dto, user) [PATCH /diagrams/:id]
  C -> D : update(id, dto, user, 'AI')
  D --> C : diagrama con autoría "vía IA"
  C --> API : 200 OK
end
note over D : applyAuthorship() pone author = Luis con source = AI;\ndiffModel() deja en la bitácora "(vía IA)"
@enduml
