@startuml seq_cu15
!include _seq.iuml
title CU15 — Consultar al Moderador IA\n<size:11>Diagrama de Secuencia · UML 2.5.1 · cada mensaje es una operación de la clase que lo recibe</size>
actor Integrante as A
boundary ":ChatPanel" as B
control ":ChatGateway" as G
control ":ModeratorService" as M
control ":DiagramsService" as D
participant ":Model<ActivityLog>" as LOG
participant ":Model<GroupChatMessage>" as CHAT
control ":AiService" as AI
control ":HybridAiProvider" as H
participant ":Server (Socket.io)" as SV
A -> B : sendText(text) [botón IA activo]
B -> G : handleSend(client, payload) [chat:send, askAi = true]
G -> M : storeUserMessage(diagramId, user, text)
M --> G : question
G -> SV : emit('chat:new-message', question)
G -> SV : emit('ai:status', {isThinking: true, promptBy})
G -> M : answer(diagramId, user, question)
par contexto dual
  M -> D : findOne(diagramId)
else
  M -> LOG : find({diagramId}) [bitácora: contexto grupal]
else
  M -> CHAT : find({diagramId, sender o addressedTo}) [hilo: contexto individual]
end
M -> AI : editDiagram(text, model, prompts)
AI -> H : editDiagram(message, model, options)
H --> AI : {reply, operations, providerUsed}
AI --> M : EditDiagramResult
M -> CHAT : create({sender: IA, addressedTo, providerUsed})
M --> G : answer, operations
G -> SV : emit('chat:new-message', answer)
G -> SV : emit('ai:status', {isThinking: false})
SV -> B : onNewMessage(message)
B --> A : "Luis, …" + badge del proveedor
note over H : Gemini primero; Ollama si no hay internet\n(detalle en el diagrama de secuencia de la sección 4.4)
@enduml
