@startuml emcu_ciclo3

' ─────────────────────────────────────────────
'  Estilos
' ─────────────────────────────────────────────
skinparam actorStyle awesome
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BorderColor     #1A5276
    BackgroundColor #D6EAF8
    FontColor       #1A252F
    FontStyle       bold
}
skinparam usecase {
    BorderColor     #2980B9
    BackgroundColor #EBF5FB
    FontColor       #1A252F
    ArrowColor      #2C3E50
}
skinparam rectangle {
    BorderColor     #2C3E50
    BackgroundColor #FDFEFE
    FontStyle       bold
    FontSize        13
}

title <b>3.1.5 EMCU — Ciclo de Vida #3</b>\nGeneracion de Backend y Asistente de IA\n<i>11 de Septiembre — 22 de Septiembre</i>

left to right direction

' ─────────────────────────────────────────────
'  Actores
' ─────────────────────────────────────────────
actor "Editor"          as Editor
actor "Creador"         as Creador
actor "Usuario"         as Usuario
actor "Asistente IA\n(Gemini API)" as AsistenteIA #technology

Editor  --|> Usuario : extends
Creador --|> Usuario : extends

' ─────────────────────────────────────────────
'  Limite del sistema
' ─────────────────────────────────────────────
rectangle "Herramienta CASE" {
    ' -- Ciclo 1 (heredados) --
    usecase "CU01 Gestionar\nClases UML"              as CU01
    usecase "CU02 Gestionar\nDiagrama"                as CU02

    ' -- Ciclo 2 (heredados) --
    usecase "CU03 Colaborar\nen Tiempo Real"          as CU03
    usecase "CU05 Exportar\nDiagrama a XMI"          as CU05

    ' -- Nuevos en Ciclo 3 --
    usecase "CU04 Generar Backend\nSpring Boot"       as CU04
    usecase "CU06 Utilizar\nAsistente de IA"         as CU06
}

' ─────────────────────────────────────────────
'  Relaciones
' ─────────────────────────────────────────────
' Acceso heredado
Usuario --> CU01
Usuario --> CU02
Usuario --> CU03
Creador --> CU05

' Nuevos accesos Ciclo 3
' Solo el Creador puede generar el backend
Creador --> CU04

' Ambos actores pueden usar el asistente de IA
Usuario --> CU06

' Include heredado
CU02 .> CU01 : <<include>>

' Extend heredados
CU03 .> CU02 : <<extend>>
CU05 .> CU02 : <<extend>>

' Nuevas relaciones Ciclo 3
' Generar backend extiende el diagrama (requiere diagrama valido)
CU04 .> CU02 : <<extend>>

' Asistente IA extiende la gestion de clases (crea/modifica via chat o voz)
CU06 .> CU01 : <<extend>>

' Generar backend incluye el uso del asistente IA (validacion inteligente)
CU04 .> CU06 : <<include>>

' El asistente IA es un actor secundario invocado por CU06
CU06 --> AsistenteIA : <<invoca>>

@enduml
