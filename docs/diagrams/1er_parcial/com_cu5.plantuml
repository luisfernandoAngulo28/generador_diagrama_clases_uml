@startuml com_cu5
!include ../2do_parcial/pud/_com.iuml
title CU5 — Guardar Diagrama\n<size:11>Diagrama de Comunicación · UML 2.5.1 · patrón ECB · Ciclo 1 (1er Parcial)</size>
object ":LienzoUML" as B <<boundary>>
object ":DiagramsController/Service" as C <<control>>
object ":Diagram (PostgreSQL)" as E <<entity>>
actor "Usuario" as A
A -down- B : "1: guardar diagrama →"
B -down- B : "2: buildModel()"
B -down- C : "3: POST/PATCH /diagrams →\n6: id ←"
C -down- E : "4: save(dto) →\n5: diagrama persistido ←"
@enduml
