@startuml com_cu9
!include ../2do_parcial/pud/_com.iuml
title CU9 — Exportar a XMI\n<size:11>Diagrama de Comunicación · UML 2.5.1 · patrón ECB · Ciclo 1 (1er Parcial)</size>
object ":LienzoUML" as B <<boundary>>
object ":DiagramsController (XMI)" as C <<control>>
object ":Diagram (PostgreSQL)" as E <<entity>>
actor "Usuario" as A
A -down- B : "1: exportar XMI →"
B -down- C : "2: GET /diagrams/:id/xmi →\n6: descarga .xmi ←"
C -down- E : "3: findOne(id) →\n4: modelo ←"
C -down- C : "5: renderXmi()"
@enduml
