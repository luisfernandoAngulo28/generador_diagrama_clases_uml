@startuml seq_cu2
!include ../2do_parcial/pud/_seq.iuml
title CU2 — Editar Clase UML\n<size:11>Diagrama de Secuencia · UML 2.5.1 · Ciclo 1 (1er Parcial)</size>
actor "Usuario" as U
boundary ":LienzoUML" as L
boundary ":Inspector (ClassInspector)" as I
U -> L : doble clic en la clase
L -> I : abrir panel con datos actuales
U -> I : modificar nombre / atributo
I -> L : onChange(umlClass actualizado)
L --> U : refrescar nodo en el lienzo
@enduml
