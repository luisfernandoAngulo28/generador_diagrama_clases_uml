@startuml seq_cu3
!include ../2do_parcial/pud/_seq.iuml
title CU3 — Eliminar Clase UML\n<size:11>Diagrama de Secuencia · UML 2.5.1 · Ciclo 1 · cada mensaje es una operación de la clase que lo recibe</size>
actor Usuario as U
boundary ":ClassInspector" as I
boundary ":App" as A
U -> I : onDelete() [botón "Eliminar clase"]
I -> A : deleteClass(classId)
A -> A : pushHistory()
A -> A : releaseLock(classId)
A --> U : la clase y sus relaciones desaparecen del lienzo
@enduml
