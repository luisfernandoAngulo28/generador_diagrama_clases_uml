@startuml seq_cu6
!include ../2do_parcial/pud/_seq.iuml
title CU6 — Cargar Diagrama Compartido\n<size:11>Diagrama de Secuencia · UML 2.5.1 · Ciclo 1 · cada mensaje es una operación de la clase que lo recibe</size>
actor Usuario as U
boundary ":App" as A
participant ":ApiClient" as API
control ":DiagramsController" as C
control ":DiagramsService" as S
participant ":Model<DiagramDocument>" as DB
participant ":UmlTypes" as T
U -> A : loadDiagram(id) [abre el enlace ?diagram=id]
A -> API : getDiagram(id)
API -> C : findOne(id) [GET /diagrams/:id]
C -> S : findOne(id)
S -> DB : findById(id)
DB --> S : documento
S --> C : diagrama
C --> API : 200 + modelo
API --> A : diagrama
A -> T : authorshipIndexOf(model)
T --> A : autoría por clase
A --> U : clases y relaciones en sus posiciones
@enduml
