@startuml com_cu6
!include ../2do_parcial/pud/_com.iuml
title CU6 — Cargar Diagrama Compartido\n<size:11>Diagrama de Comunicación · UML 2.5.1 · patrón ECB · Ciclo 1 (1er Parcial)</size>
object ":LienzoUML" as B <<boundary>>
object ":DiagramsController/Service" as C <<control>>
object ":Diagram (PostgreSQL)" as E <<entity>>
actor "Usuario" as A
A -down- B : "1: abrir enlace compartido →"
B -down- C : "2: GET /diagrams/:id →\n5: modelo ←"
C -down- E : "3: findOne(id) →\n4: modelo ←"
B -down- B : "6: reconstruir lienzo"
@enduml
