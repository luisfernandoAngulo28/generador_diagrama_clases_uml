# dependencies
node_modules/

# build output
dist/
build/

# env
.env
.env.local
.env.production
*.env
!.env.production.example

# logs
*.log
npm-debug.log*
*-log.txt
*-err.txt
*.tsbuildinfo

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# generated backend output (from the code generator engine)
generated-output/
generated-out/

# APK builds (demasiado grandes para git — 280+ MB; se regeneran con flutter build)
*.apk
*.aab

# scratch dir(s) used when editing docs/*.docx directly via XML
docs_docwork*/

# deployment secrets (SSH keys, etc.) — never commit
.deploy/
*.pem
